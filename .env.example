# Supabase - get these from Supabase dashboard, Settings, API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider - which AI runs the automation features.
# One of: anthropic (default, paid, best quality) | gemini (free tier, has vision) | groq (free tier, fast)
AI_PROVIDER=anthropic

# Anthropic (Claude) - get from console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini - free key from aistudio.google.com (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Groq - free key from console.groq.com (used when AI_PROVIDER=groq)
GROQ_API_KEY=

# Email summaries via Resend (resend.com). Leave RESEND_API_KEY blank to disable email.
RESEND_API_KEY=
# From address. Default uses Resend's shared sender (works only to your own signup email
# until you verify a domain). Once you verify a domain, set e.g. "RelayOps <alerts@yourdomain.com>".
RESEND_FROM=
# Where summaries go. Comma-separated. If blank, falls back to admin user emails.
SUMMARY_EMAIL_TO=
# Base URL used for deep links inside emails.
NEXT_PUBLIC_APP_URL=https://relayops-system.vercel.app
